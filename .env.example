# The app makes its own copy of this file, with the values empty, in %LOCALAPPDATA%\AniLife and fills it in
# from the Profile page. You only need to copy this by hand to use environment-style settings. Never commit
# the real .env file.
# MyAnimeList OAuth client id (create an app at https://myanimelist.net/apiconfig with
# redirect URL http://localhost:8765).
MAL_CLIENT_ID=
# AniList OAuth (https://anilist.co/settings/developer, redirect URL
# https://anilist.co/api/v2/oauth/pin).
ANILIST_CLIENT_ID=56997
# Only needed to exchange an AniList authorization code for a token.
ANILIST_CLIENT_SECRET=
